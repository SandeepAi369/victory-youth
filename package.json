{
  "name": "victory-youth",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.core.config.ts && drizzle-kit generate --config drizzle.media.config.ts",
    "db:push": "drizzle-kit push --config drizzle.core.config.ts && drizzle-kit push --config drizzle.media.config.ts",
    "db:media:local": "node scripts/d1-local-migrate.mjs",
    "build:cloudflare": "npx opennextjs-cloudflare build",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "preview": "npm run build:cloudflare && wrangler dev",
    "setup": "node scripts/setup.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "framer-motion": "^13.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.34.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.129.1"
  }
}
