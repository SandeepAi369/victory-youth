# Copy to .env and fill in — or let `npm run setup` (cloud) / `npm run setup -- --local` write it for you.
# Never commit .env.

# --- Core database (Turso) -----------------------------------------------------
# Cloud:  libsql://<db>-<org>.turso.io   (turso db show <db> --url)
# Local:  file:.local/core.db            (no token needed)
TURSO_CORE_DATABASE_URL=
TURSO_CORE_AUTH_TOKEN=

# --- Admin login ----------------------------------------------------------------
# At least 12 characters. Admin login is disabled when this is missing.
ADMIN_PASSWORD=

# --- Cloudinary -----------------------------------------------------------------
# Server-side (signed image deletes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Browser uploads (public values; an UNSIGNED upload preset)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Cloudflare (only for `npm run db:push` to the remote D1 media database) ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Optional: notice broadcasts ------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
RESEND_API_KEY=
